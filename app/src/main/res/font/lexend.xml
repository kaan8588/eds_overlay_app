<?xml version="1.0" encoding="utf-8"?>
<!--
    Lexend variable font family (OFL).
    Maps Android font weights onto the bundled lexend_wght.ttf so
    textStyle="bold" and textFontWeight resolve to real Lexend cuts
    instead of synthetic bold.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/lexend_wght"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400"
        app:font="@font/lexend_wght"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 400"
        app:fontWeight="400" />
    <font
        android:font="@font/lexend_wght"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 500"
        android:fontWeight="500"
        app:font="@font/lexend_wght"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 500"
        app:fontWeight="500" />
    <font
        android:font="@font/lexend_wght"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 600"
        android:fontWeight="600"
        app:font="@font/lexend_wght"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 600"
        app:fontWeight="600" />
    <font
        android:font="@font/lexend_wght"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700"
        app:font="@font/lexend_wght"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 700"
        app:fontWeight="700" />
</font-family>
